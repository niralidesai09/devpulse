# Copy this file to .env.local and fill in the values.
# Never commit .env.local — only this example file is committed.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Data sources ---
# GitHub personal access token (no scopes needed for public issue search)
GITHUB_TOKEN=
# Optional: raises Stack Exchange rate limit (https://stackapps.com/apps/oauth/register)
STACKEXCHANGE_KEY=

# --- Email (https://resend.com/api-keys) ---
RESEND_API_KEY=
BRIEF_TO_EMAIL=

# --- Security: secret that protects /api/cron and the "Run now" button ---
# Generate with: openssl rand -hex 32
CRON_SECRET=
