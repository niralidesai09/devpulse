# Copy to .env.local and fill in. Never commit real values.
# Required = the app does not work without it. Optional = a feature is disabled without it.

# --- Supabase (Project Settings → API) -------------------------------------
# Required. Project URL (safe to expose, but only used on the server).
NEXT_PUBLIC_SUPABASE_URL=
# Required. Service-role / secret key. SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Not used by v2 (the browser never queries Supabase). Kept for v1 compatibility; may be left empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local only, for `npm run db:migrate`. Supabase → Connect → Session pooler URI (with password).
SUPABASE_DB_URL=

# --- Google Gemini (https://aistudio.google.com/apikey) --------------------
# Required for analysis and briefs. Must be a Gemini *Flash* model id (the app refuses others).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Data sources ----------------------------------------------------------
# Required for GitHub Issues. Fine-grained token with NO permissions (public search only).
GITHUB_TOKEN=
# Optional. Raises the Stack Exchange daily quota (https://stackapps.com/apps/oauth/register).
STACKEXCHANGE_KEY=

# --- Access control --------------------------------------------------------
# Required. Protects /api/cron/weekly (Vercel Cron sends it as a Bearer token) and signs admin sessions.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Required for editing. Passcode for /login (topic edits, runs, decisions). Use a long random value.
ADMIN_PASSCODE=

# --- Email delivery (optional, https://resend.com/api-keys) ----------------
RESEND_API_KEY=
# Comma-separated recipients. With the default sender, Resend only delivers to your own account email.
BRIEF_TO_EMAIL=
# Optional verified sender, e.g. "DevPulse <pulse@yourdomain.com>". Default: onboarding@resend.dev
BRIEF_FROM_EMAIL=

# --- Reporting (optional) --------------------------------------------------
# IANA timezone for reporting weeks. Default Asia/Kolkata.
REPORT_TIMEZONE=Asia/Kolkata
# Weekday the reporting week ends on (0=Sun … 5=Fri). Default 5.
REPORT_WEEK_END_DAY=5
# Complete weeks each collection looks back (2–6). Default 3.
LOOKBACK_WEEKS=3
# Max discussions sent to Gemini per run; the rest stay queued. Default 400.
MAX_ANALYZE_PER_RUN=400
# Public base URL used in email links. Defaults to the Vercel production URL.
APP_URL=

# --- Deployment (local only, for `npx vercel` CLI) --------------------------
VERCEL_TOKEN=
